{
  "name": "mcp-games-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MCP Games super server and playable AI-agent flagship experience",
  "scripts": {
    "build": "turbo run build",
    "build:flagship": "turbo run build --filter=@omnigents/mcp-games-site --filter=mcp-connector --filter=@omnigents/mcp-games-server",
    "dev": "turbo run dev --filter=@omnigents/mcp-games-site --filter=mcp-connector",
    "dev:all": "turbo run dev",
    "dev:site": "pnpm --dir apps/mcp-games-site dev",
    "dev:connector": "pnpm --dir apps/mcp-connector dev",
    "start:site": "pnpm --dir apps/mcp-games-site start",
    "start:connector": "pnpm --dir apps/mcp-connector start",
    "start:mcp": "pnpm --dir packages/mcp-games-server start",
    "lint": "turbo run lint",
    "lint:security": "eslint --config .eslintrc.security.json \"**/*.{js,jsx,ts,tsx}\"",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-plugin-security": "^2.1.0",
    "jest": "^30.2.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@8.12.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=8.0.0"
  }
}
