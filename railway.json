{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/mcp-connector/Dockerfile",
    "watchPatterns": [
      "apps/mcp-connector/**",
      "packages/mcp-games-server/**",
      "packages/mcp-sdk/**",
      "packages/shared/**",
      "packages/shared-types/**",
      "games/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "turbo.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "overlapSeconds": 30,
    "drainingSeconds": 15
  }
}
