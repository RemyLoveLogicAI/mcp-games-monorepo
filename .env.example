# Local service ports
GAMES_SERVER_PORT=3000
MCP_CONNECTOR_PORT=3001

# Browser origins allowed to call the connector (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
MCP_CONNECTOR_AUTH_TOKEN=

# Optional explicit path to the built stdio server entry. Local development
# resolves packages/mcp-games-server/dist/index.js automatically.
MCP_GAMES_SERVER_ENTRY=
MCP_GAMES_ROOT=
MCP_GAMES_WORKDIR=

# Optional production persistence. When omitted, the game server uses its
# in-memory state store so a fresh checkout works without external credentials.
SUPABASE_URL=
SUPABASE_KEY=

# Redis telemetry bus
REDIS_URL=redis://localhost:6379

# Site wiring
# Production uses the same-origin Sites proxy. Local development may point
# directly at the unauthenticated local connector.
NEXT_PUBLIC_MCP_CONNECTOR_URL=http://localhost:3001

# Canonical destination used by the legacy CYOA entry surface.
MCP_GAMES_FLAGSHIP_URL=https://mcp-games-command-center.lovelogic-ai.chatgpt.site
